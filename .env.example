# ---------------------------------------------------------------------------
# Sonarr connection (server-side only, never exposed to the browser)
# ---------------------------------------------------------------------------
# Leave both blank to run in DEMO MODE with a built-in mock library.
SONARR_URL=http://localhost:8989
SONARR_API_KEY=

# ---------------------------------------------------------------------------
# Playback (optional)
# ---------------------------------------------------------------------------
# Sonarr does not serve video. Point this at your media server so the player
# can deep-link to the real stream. {id} is replaced with the Sonarr episode id.
# Examples:
#   Jellyfin: http://localhost:8096/web/index.html#!/details?id={id}
#   Plex:     https://app.plex.tv/desktop
NEXT_PUBLIC_MEDIA_BASE=

# ---------------------------------------------------------------------------
# JARVIS GUI assistant backend (optional, OpenAI-compatible)
# ---------------------------------------------------------------------------
# Enables live assistant replies at /jarvis via /api/jarvis/chat
# JARVIS_API_KEY=
# JARVIS_BASE_URL=https://api.openai.com/v1
# JARVIS_MODEL=gpt-4o-mini
